{
    "log": {
        "level": "warn"
    },
    "dns": {
        "servers": [
            {
                "tag": "remote-doh-1",
                "type": "https",
                "server": "1.1.1.1",
                "domain_resolver": "local-dns",
                "detour": "proxy"
            },
            {
                "tag": "remote-doh-2",
                "type": "https",
                "server": "dns.google",
                "domain_resolver": "local-dns",
                "detour": "proxy"
            },
            {
                "tag": "local-dns",
                "type": "local"
            }
        ],
        "rules": [
            {
                "rule_set": [
                    "geosite-category-ads-all",
                    "geosite-adguard-list"
                ],
                "action": "predefined",
                "rcode": "NXDOMAIN"
            },
            {
                "rule_set": [
                    "geosite-phishing",
                    "geosite-malware"
                ],
                "action": "predefined",
                "rcode": "NXDOMAIN"
            },
            {
                "rule_set": [
                    "geosite-private"
                ],
                "server": "local-dns"
            },
            {
                "rule_set": [
                    "geosite-ru-blocked"
                ],
                "server": "remote-doh-1"
            }
        ],
        "final": "remote-doh-1",
        "strategy": "prefer_ipv4"
    },
    "http_clients": [
        {
            "tag": "rule-set-download",
            "detour": "proxy"
        }
    ],
    "inbounds": [
        {
            "type": "socks",
            "tag": "socks-in",
            "listen": "127.0.0.1",
            "listen_port": 10808
        },
        {
            "type": "http",
            "tag": "http-in",
            "listen": "127.0.0.1",
            "listen_port": 10809
        },
        {
            "type": "tun",
            "tag": "tun-in",
            "address": "172.16.0.1/30",
            "auto_route": true,
            "strict_route": true
        }
    ],
    "outbounds": [
        {
            "type": "direct",
            "tag": "direct"
        }
    ],
    "route": {
        "auto_detect_interface": true,
        "final": "direct",
        "default_domain_resolver": "remote-doh-1",
        "default_http_client": "rule-set-download",
        "rules": [
            {
                "inbound": "socks-in",
                "action": "sniff"
            },
            {
                "inbound": "http-in",
                "action": "sniff"
            },
            {
                "inbound": "tun-in",
                "action": "sniff"
            },
            {
                "port": 53,
                "action": "hijack-dns"
            },
            {
                "network": "tcp",
                "port": 853,
                "action": "hijack-dns"
            },
            {
                "rule_set": [
                    "geosite-private"
                ],
                "outbound": "direct"
            },
            {
                "ip_is_private": true,
                "outbound": "direct"
            },
            {
                "rule_set": [
                    "geosite-category-ads-all",
                    "geosite-adguard-list"
                ],
                "action": "reject"
            },
            {
                "rule_set": [
                    "geosite-phishing",
                    "geosite-malware"
                ],
                "action": "reject"
            },
            {
                "rule_set": [
                    "geoip-phishing",
                    "geoip-malware"
                ],
                "action": "reject"
            },
            {
                "rule_set": [
                    "geosite-ru-available-only-inside"
                ],
                "outbound": "direct"
            },
            {
                "rule_set": [
                    "geoip-ru"
                ],
                "outbound": "direct"
            },
            {
                "domain_suffix": [
                    "ru",
                    "su",
                    "xn--p1ai",
                    "moscow",
                    "xn--80adxhks",
                    "xn--p1acf"
                ],
                "outbound": "direct"
            },
            {
                "rule_set": [
                    "geosite-ru-blocked"
                ],
                "outbound": "proxy"
            },
            {
                "rule_set": [
                    "geoip-ru-blocked",
                    "geoip-ru-blocked-community",
                    "geoip-re-filter"
                ],
                "outbound": "proxy"
            }
        ],
        "rule_set": [
            {
                "tag": "geosite-private",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geosite/geosite-private.srs"
            },
            {
                "tag": "geosite-category-ads-all",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geosite/geosite-category-ads-all.srs"
            },
            {
                "tag": "geosite-ru-available-only-inside",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geosite/geosite-ru-available-only-inside.srs"
            },
            {
                "tag": "geosite-ru-blocked",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geosite/geosite-ru-blocked.srs"
            },
            {
                "tag": "geoip-ru",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geoip/geoip-ru.srs"
            },
            {
                "tag": "geoip-ru-blocked",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geoip/geoip-ru-blocked.srs"
            },
            {
                "tag": "geoip-ru-blocked-community",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geoip/geoip-ru-blocked-community.srs"
            },
            {
                "tag": "geoip-re-filter",
                "type": "remote",
                "format": "binary",
                "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geoip/geoip-re-filter.srs"
            },
            {
                "tag": "geosite-phishing",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/KaringX/karing-ruleset/raw/refs/heads/sing/geo/geosite/phishing.srs"
            },
            {
                "tag": "geoip-phishing",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/KaringX/karing-ruleset/raw/refs/heads/sing/geo/geoip/phishing.srs"
            },
            {
                "tag": "geosite-malware",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/KaringX/karing-ruleset/raw/refs/heads/sing/geo/geosite/malware.srs"
            },
            {
                "tag": "geoip-malware",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/KaringX/karing-ruleset/raw/refs/heads/sing/geo/geoip/malware.srs"
            },
            {
                "tag": "geosite-adguard-list",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/xmdhs/sing-box-ruleset/raw/refs/heads/rule-set/AdGuardSDNSFilterSingBox.srs"
            }
        ]
    },
    "experimental": {
        "cache_file": {
            "enabled": true,
            "store_fakeip": false,
            "store_dns": true
        }
    }
}